---
import { Search } from '@lucide/astro';

/* The field-shaped search button at the top of the docs sidebar. The phone bar
   has its own icon-only one, in SiteHeader. */
---

<button
  type="button"
  class="ml-search-trigger"
  commandfor="ml-search"
  command="show-modal"
  data-ml-search-open
  aria-haspopup="dialog"
>
  <Search size={15} />
  Search
  <kbd class="ml-kbd" data-ml-kbd>⌘K</kbd>
</button>
