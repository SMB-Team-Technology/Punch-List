---
import { ATTRIBUTION, FOOTER_COLUMNS, TRADEMARK_NOTICE } from '../lib/footer';
import { STATUS_LABEL } from '../lib/status';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

{/* The footer, white and closed off by the landing frame's bottom seam, the
    same edge `/` ends on. The columns sit on the same `--container-page` box
    and gutter as the article above, so the footer starts on the left edge every
    paragraph starts on.

    Structure, copy and spacing are shared with the app shell's own footer in
    apps/worker/web/Landing.tsx; the links come from lib/footer.ts and the two
    renderers differ only in the width of the column they sit in. Change one,
    change the other. */}
<footer class="ml-floor">
  <div class="ml-floor-seam" aria-hidden="true"></div>
  <div class="ml-floor-inner">
    <div class="grid grid-cols-2 gap-x-8 gap-y-9 text-label sm:grid-cols-4">
      {
        FOOTER_COLUMNS.map((col) => (
          <div>
            <p class="m-0 mb-3 text-label font-semibold tracking-label text-ink">{col.heading}</p>
            <ul class="m-0 list-none space-y-0.5 p-0">
              {col.links.map((l) => (
                <li class="m-0 p-0">
                  <a
                    class="ml-floor-link"
                    href={l.href}
                    target={l.external ? '_blank' : undefined}
                    rel={l.external ? 'noopener noreferrer' : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Fine print, and set as fine print: 12px, one step quieter than the link
        columns and the same size as the colophon it sits with, so the two close
        the footer as one block. It used to run at the 13px label step, which
        made three grey lines of legal boilerplate the heaviest text down here.

        `max-w-none` on both: global.css caps every `p` at the 560px prose
        measure, which is right for reading copy and wrong here — a fine-print
        line that wraps 152px short of the grid above it reads as ragged, not as
        a measure. */}
    <p class="ml-floor-fine mt-10">{TRADEMARK_NOTICE}</p>
    {/* The closing row: the colophon on the page's spine, where the lockup
        belongs, and the status line anchored to the opposite end. Two items on
        one line rather than a third stacked grey line. `items-center`, not
        `items-baseline`: the colophon is itself a flex row led by the mark, so
        its first baseline is the mark's bottom edge rather than the text's, and
        baseline alignment dropped the status 5px below the line it sits on.
        Both items are one 19px line, so centring aligns them exactly.

        The reference for this row put the status on the left; it is on the right
        here because the left edge of the floor is the brand's edge. */}
    <div class="mt-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
      <p class="ml-floor-fine mt-0 flex items-start gap-2">
        {/* Aligned to the FIRST line, not to the block: the line wraps on a
            phone, and a centred mark then floats between the two rows. */}
        <Logo size={14} class="mt-[3px] shrink-0" />
        <span>
          &copy; {year} SMB Team &middot; Punch List &middot;
          <a href={ATTRIBUTION.href} target="_blank" rel="noopener noreferrer">{ATTRIBUTION.label}</a>
        </span>
      </p>
      {/* Rendered at `ok`, which is what the page itself attests: it was served
          by the Worker that answers `/api/health`. The script below probes that
          route and downgrades this in place if D1 or R2 is not answering, so no
          state is gated on JS running — without it the line still reads, it just
          stops being able to tell you about an outage. `role="status"` so the
          downgrade is announced rather than silently swapped. */}
      <p class="ml-live m-0 max-w-none" data-ml-status="ok" role="status">
        <span class="ml-live-dot" aria-hidden="true"></span>
        <span data-ml-status-label>{STATUS_LABEL.ok}</span>
      </p>
    </div>
  </div>

  {/* The signature: the brand word full-bleed across the floor, cut partway down
      the letterforms and faded out so the cut is never a visible line. It takes
      no gutter and no max-width on purpose — this is the one element meant to
      touch both edges — and nothing sits beneath it.

      `aria-hidden` because the accessible wordmark is the one in the header;
      this is texture, not a second heading. */}
  <div class="ml-signature-clip" aria-hidden="true">
    <span class="ml-signature">MarkLayer</span>
  </div>
</footer>

<script>
  import { probeStatus, STATUS_LABEL } from '../lib/status';

  const line = document.querySelector('[data-ml-status]');
  const label = line?.querySelector('[data-ml-status-label]');
  if (line instanceof HTMLElement && label) {
    // Only ever downgrades. `ok` is already on screen, so resolving to it is a
    // no-op, and a failed probe resolves to `ok` by design.
    probeStatus().then((status) => {
      if (status === 'ok') return;
      line.dataset.mlStatus = status;
      label.textContent = STATUS_LABEL[status];
    });
  }
</script>
