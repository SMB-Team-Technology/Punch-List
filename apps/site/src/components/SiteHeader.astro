---
import { Search } from '@lucide/astro';
import { getDocsNav } from '../lib/docs-nav';
import { SECTIONS } from '../lib/site';
import DocsNav from './DocsNav.astro';
import DocsSearch from './DocsSearch.astro';
import Logo from './Logo.astro';

interface Props {
  /** This page's path. Lights its own link, and its row in the phone menu. */
  path: string;
}

const { path } = Astro.props;
const nav = await getDocsNav();
---

{/* The landing page's bar: glass, sticky, the lockup on the left and the
    sections as quiet pills on the right.
    Below `lg` the sections do not fit on one line, and a wrapped sticky bar eats
    a third of a phone, so they move into a menu sheet. */}
<header class="ml-nav">
  <div class="mx-auto flex h-14 w-full max-w-page items-center justify-between gap-6 px-(--gutter)">
    <a class="ml-wordmark" href="/" aria-label="Punch List home">
      <Logo size={26} class="shrink-0" />
      Punch List
    </a>
    {/* Cancels the pills' inner padding, so the ink lands on the column's edge. */}
    <nav class="-mx-3 hidden items-center lg:flex" aria-label="Sections">
      {
        SECTIONS.map((s) => (
          <a
            class="ml-nav-link"
            href={s.href}
            data-active={s.href === path ? '' : undefined}
            aria-current={s.href === path ? 'page' : undefined}
          >
            {s.label}
          </a>
        ))
      }
    </nav>
    <div class="-mr-[9px] flex items-center lg:hidden">
      <button
        type="button"
        class="ml-nav-icon cursor-pointer border-0 bg-transparent"
        commandfor="ml-search"
        command="show-modal"
        data-ml-search-open
        aria-haspopup="dialog"
      >
        <span class="sr-only">Search</span>
        <Search size={18} />
      </button>
      <button type="button" class="ml-nav-icon ml-menu-btn cursor-pointer border-0 bg-transparent" popovertarget="ml-menu">
        <span class="sr-only">Menu</span>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <line x1="3" y1="6.5" x2="15" y2="6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line>
          <line x1="3" y1="11.5" x2="15" y2="11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
          ></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="ml-menu" class="ml-menu lg:hidden" popover>
    <DocsNav nav={nav} path={path} />
  </div>
</header>
<DocsSearch nav={nav} />
