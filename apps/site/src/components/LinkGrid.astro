---
import { ArrowUpRight } from '@lucide/astro';
interface Props {
  links: { href: string; label: string }[];
}

const { links } = Astro.props;
---

{/* Ruled rows rather than bordered cards: one hairline per row, and a diagonal
    that travels on hover. Nothing lifts, nothing glows. */}
<div class="ml-rows">
  {
    links.map((l) => (
      <a class="ml-row" href={l.href}>
        <span>{l.label}</span>
        <ArrowUpRight size={11} stroke-width={1.4} />
      </a>
    ))
  }
</div>
