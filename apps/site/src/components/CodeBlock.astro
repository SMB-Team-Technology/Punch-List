---
import { Code } from 'astro:components';
import { toHtml } from 'hast-util-to-html';
import { codeBlockBar, LABELS } from '../lib/rehype-code-blocks.mjs';

/**
 * The Markdown pages' code block (rehype-code-blocks.mjs) for an .astro page:
 * the same bar, built by the same function, wired by ArticleLayout.
 */
interface Props {
  code: string;
  lang: 'bash' | 'json' | 'markdown' | 'plaintext';
  label?: string;
  class?: string;
}

const { code, lang, label = LABELS[lang] ?? lang, class: cls } = Astro.props;
const bar = toHtml(codeBlockBar(label));
---

<div class:list={['ml-code', cls]}>
  <Fragment set:html={bar} />
  <Code code={code} lang={lang} theme="css-variables" />
</div>
