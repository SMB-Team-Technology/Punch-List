---
import copy from '../../data/home-copy.json';
import { HELP_COMMENT_STEPS } from '../../lib/help';
import { ATTRIBUTION, FOOTER_COLUMNS } from '../../lib/footer';

// Prerendered content for `/`.
//
// This is crawler and first-paint surface, not UI: apps/worker/web/main.tsx
// clears #app on boot (`root.innerHTML = ''`) and renders <Landing/> over it, so
// nobody with JS ever sees this markup. Keep the claims here in sync with
// apps/worker/web/Landing.tsx.
---

<p style="margin: 0 0 12px; color: #6e6e6e">Punch List by SMB Team</p>
<h1>{copy.headline}</h1>
<p>{copy.lede}</p>

<h2>How it works</h2>
<p>
  SMB Team sends you a link to your new website. It opens in your browser with nothing to install and no account to
  create, on a computer or a phone.
</p>
<ol>
  {HELP_COMMENT_STEPS.map((step) => <li>{step}</li>)}
</ol>
<p>
  Your note is pinned to the spot you clicked and lands on the team's punch list. Each one shows its status, from open
  to in progress to resolved, so you can watch your list get checked off. Reply on any note to keep the conversation in
  one place.
</p>
<p>
  Review links are cleaned up 90 days after their last activity, and any comment or view resets that clock. Read the
  <a href="/help">help page</a> for the details, or contact your SMB Team project manager.
</p>

<footer>
  <nav>
    {
      FOOTER_COLUMNS.flatMap((col) => col.links)
        .filter((l) => l.href !== '/')
        .map((l) => <a href={l.href}>{l.label}</a>)
    }
  </nav>
  <p>
    <small><a href={ATTRIBUTION.href}>{ATTRIBUTION.label}</a></small>
  </p>
</footer>
