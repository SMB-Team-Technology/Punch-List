---
/**
 * The install button's glyph, drawn the same way the app's own landing page
 * draws it (apps/worker/web/landing/ChromeStoreLink.tsx `ChromeIcon`): a stroked construction of
 * the browser's mark, at the site's own stroke weight, bare and in the label's
 * colour. Not the four-colour brand asset — the button is one flat black
 * surface, and a full-colour logo dropped onto it is a sticker.
 */
import { siGooglechrome } from 'simple-icons';
---

<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siGooglechrome.path}></path></svg>
