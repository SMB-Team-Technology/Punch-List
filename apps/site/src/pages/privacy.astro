---
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { AGENCY_NAME, AGENCY_URL, ORIGIN, pageOgImage, REPO_URL } from '../lib/site';

// One string: the card is keyed by a hash of the heading, so an h1 edited
// without its twin would serve the old wording forever.
const h1 = 'Privacy Policy';
const title = 'Privacy Policy · Punch List';
const description =
  'What Punch List by SMB Team stores when you leave feedback on a website, how long it keeps it, and who to contact. No tracking, and your data is never sold.';
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={`${ORIGIN}/privacy`}
      ogType="website"
      ogImage={pageOgImage({ heading: h1, path: '/privacy' })}
    />
  </head>
  <body>
    <SiteHeader path="/privacy" />
    <div class="ml-shell">
      <Breadcrumbs crumbs={[{ name: 'Punch List', path: '/' }, { name: 'Privacy' }]} />
      <h1>{h1}</h1>
      {/* Stated review date of the policy itself. It changes when the policy
          changes, not when the page is rebuilt. */}
      <p class="ml-meta mt-0 mb-8">Last updated: October 2026</p>

      <p>
        Punch List (<a href={ORIGIN}>{ORIGIN.replace('https://', '')}</a>) is run by
        <a href={AGENCY_URL}>{AGENCY_NAME}</a> so our clients can leave feedback on the websites we build for them. This
        page explains what it stores and why.
      </p>

      <h2>What we store</h2>
      <ul>
        <li>
          <strong>Feedback boards.</strong> The address of the page being reviewed and everything left on it: comments,
          replies, drawings, highlights, statuses and suggested edits.
        </li>
        <li>
          <strong>Your display name.</strong> Clients do not need an account. The name you type, or a randomly generated
          one, is kept in your browser and shown next to what you leave on a board.
        </li>
        <li>
          <strong>Files you add.</strong> Screenshots, images, PDFs and voice or video notes attached to a comment.
        </li>
        <li>
          <strong>Team sign-in.</strong> {AGENCY_NAME} staff sign in with an emailed link, so we keep their email address
          and a session cookie. Clients never sign in.
        </li>
        <li>
          <strong>Invitations.</strong> When someone invites a person to a board by email, that address is kept so the
          same invitation is not sent twice.
        </li>
      </ul>
      <p>
        If a board is locked with a password, we store only a hash of the password, and a hash of the address of anyone
        who gets it wrong, briefly, to stop guessing. Voice and video calls on a board go directly between the
        people on it and are not recorded.
      </p>

      <h2>How long we keep it</h2>
      <p>
        A board, and the files attached to it, is deleted automatically 90 days after anyone last opened it. Boards that a
        team member has saved to their dashboard are kept until they delete them or set an expiry. Sign-in links expire
        after 15 minutes. To have anything removed sooner, email us.
      </p>

      <h2>Analytics and cookies</h2>
      <p>
        Punch List runs no analytics and no advertising. The only cookie is the sign-in session for {AGENCY_NAME} staff.
      </p>

      <h2>Where it lives</h2>
      <p>
        Punch List runs on <a href="https://www.cloudflare.com">Cloudflare</a>, which hosts the app, stores the data and
        sends the sign-in emails. To show the page being reviewed, our server fetches it from its own address. Cloudflare
        processes this on our behalf; we do not sell, rent or share your data with anyone else.
      </p>

      <h2>Contact</h2>
      <p>
        Questions, or a request to see or delete your data: <a href="mailto:support@smbteam.com">support@smbteam.com</a>.
      </p>

      <p class="ml-meta">
        Punch List is built on <a href={REPO_URL}>MarkLayer</a>, open source under the Apache-2.0 licence.
      </p>
    </div>
    <SiteFooter />
  </body>
</html>
